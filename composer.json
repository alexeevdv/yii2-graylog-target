{
    "name": "alexeevdv/yii2-graylog-target",
    "description": "Yii2 graylog2 log target",
    "type": "yii2-extension",
    "license": "MIT",
    "keywords": ["yii2", "graylog", "target", "gelf"],
    "authors": [
        {
            "name": "Dmitry V. Alekseev",
            "email": "mail@alexeevdv.ru"
        }
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        }
    },
    "autoload": {
        "psr-4": {
            "alexeevdv\\yii\\graylog\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "tests\\": "tests/unit"
        }
    },
    "require": {
        "graylog2/gelf-php": "^1.6",
        "yiisoft/yii2": "^2.0"
    },
    "require-dev": {
        "behat/gherkin": "4.4.*",
        "codeception/codeception": "^4.0",
        "codeception/module-asserts": "^1.3",
        "yiisoft/yii2-coding-standards": "^2.0"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "scripts": {
        "codeception": "@php vendor/bin/codecept run",
        "phpcs": "@php vendor/bin/phpcs --standard=vendor/yiisoft/yii2-coding-standards/Yii2 --extensions=php src",
        "tests": [
            "@phpcs",
            "@codeception"
        ]
    }
}
